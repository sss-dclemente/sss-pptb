{
  "name": "@simplesmoothsafe/pptb-audit-matrix",
  "version": "0.1.0",
  "displayName": "SSS Audit Config Matrix",
  "description": "Org, table and column audit flags on one screen: cross-environment diff against a second connection or a snapshot, bulk set with preview and confirm, CSV and snapshot export.",
  "main": "index.html",
  "icon": "icon.svg",
  "license": "MIT",
  "keywords": ["powerplatform", "dataverse", "toolbox", "pptb", "audit", "auditing", "compliance", "metadata", "security"],
  "author": "Simple Smooth Safe",
  "contributors": [
    { "name": "Duarte Clemente", "url": "https://simplesmoothsafe.com" }
  ],
  "homepage": "https://simplesmoothsafe.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sss-dclemente/sss-pptb.git",
    "directory": "tools/audit-matrix"
  },
  "configurations": {
    "repository": "https://github.com/sss-dclemente/sss-pptb",
    "website": "https://simplesmoothsafe.com",
    "readmeUrl": "https://raw.githubusercontent.com/sss-dclemente/sss-pptb/main/tools/audit-matrix/README.md"
  },
  "features": {
    "multiConnection": "optional",
    "connectionRequirement": "required",
    "minAPI": "1.2.0"
  },
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "dev-watch": "vite build --mode development --watch",
    "typecheck": "tsc --noEmit",
    "validate": "node node_modules/@pptb/validate/dist/cli.js",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@pptb/types": "^1.2.5",
    "@pptb/validate": "^1.0.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "files": ["dist"]
}
