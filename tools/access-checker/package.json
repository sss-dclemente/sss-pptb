{
  "name": "@simplesmoothsafe/pptb-access-checker",
  "version": "0.1.4",
  "displayName": "SSS Access Checker",
  "description": "Why can (or can't) a user do X on a record? Verdict per access right with the chain that produced it: roles, teams, business unit, ownership, shares, hierarchy, column security.",
  "main": "index.html",
  "icon": "icon.svg",
  "license": "MIT",
  "keywords": ["powerplatform", "dataverse", "toolbox", "pptb", "security", "security-roles", "sharing", "column-security", "access"],
  "author": "Simple Smooth Safe",
  "contributors": [
    { "name": "Duarte Clemente", "url": "https://simplesmoothsafe.com" }
  ],
  "homepage": "https://simplesmoothsafe.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sss-dclemente/sss-pptb.git",
    "directory": "tools/access-checker"
  },
  "configurations": {
    "repository": "https://github.com/sss-dclemente/sss-pptb",
    "website": "https://simplesmoothsafe.com",
    "readmeUrl": "https://raw.githubusercontent.com/sss-dclemente/sss-pptb/main/tools/access-checker/README.md"
  },
  "features": {
    "multiConnection": "none",
    "connectionRequirement": "required",
    "minAPI": "1.2.0"
  },
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "dev-watch": "vite build --mode development --watch",
    "typecheck": "tsc --noEmit",
    "validate": "node node_modules/@pptb/validate/dist/cli.js",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@pptb/types": "^1.2.5",
    "@pptb/validate": "^1.0.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "files": ["dist"]
}
