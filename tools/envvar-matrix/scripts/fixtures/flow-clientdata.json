{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": { "connectionReferenceLogicalName": "sss_dataverse_a" },
        "api": { "name": "shared_commondataserviceforapps" }
      },
      "shared_commondataserviceforapps_1": {
        "runtimeSource": "embedded",
        "connection": { "connectionReferenceLogicalName": "sss_dataverse_b" },
        "api": { "name": "shared_commondataserviceforapps" }
      },
      "shared_office365": {
        "runtimeSource": "invoker",
        "connection": { "connectionReferenceLogicalName": "sss_o365_a" },
        "api": { "name": "shared_office365" }
      },
      "shared_office365_1": {
        "runtimeSource": "embedded",
        "connection": { "connectionReferenceLogicalName": "sss_o365_b" },
        "api": { "name": "shared_office365" }
      },
      "shared_office365_10": {
        "runtimeSource": "embedded",
        "connection": { "connectionReferenceLogicalName": "sss_o365_c" },
        "api": { "name": "shared_office365" }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": { "defaultValue": {}, "type": "Object" },
        "$authentication": { "defaultValue": {}, "type": "SecureObject" }
      },
      "triggers": {
        "When_a_row_is_added": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "SubscribeWebhookTrigger", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": { "subscriptionRequest/message": 1, "subscriptionRequest/entityname": "account", "subscriptionRequest/scope": 4 },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Get_a_row_by_ID": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_commondataserviceforapps_1", "operationId": "GetItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
            "parameters": { "entityName": "contacts", "recordId": "@triggerOutputs()?['body/_primarycontactid_value']" },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Condition": {
          "runAfter": { "Get_a_row_by_ID": ["Succeeded"] },
          "type": "If",
          "expression": { "and": [{ "equals": ["@outputs('Get_a_row_by_ID')?['body/statecode']", 0] }] },
          "actions": {
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_office365_1", "operationId": "SendEmailV2", "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365" },
                "parameters": { "emailMessage/To": "ops@contoso.com", "emailMessage/Subject": "New account" },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {
              "Scope": {
                "type": "Scope",
                "actions": {
                  "Send_an_email_(V2)_2": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": { "connectionName": "shared_office365_10", "operationId": "SendEmailV2", "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365" },
                      "parameters": { "emailMessage/To": "ops@contoso.com", "emailMessage/Subject": "Inactive" },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "Send_as_invoker": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": { "connectionName": "shared_office365", "operationId": "SendEmailV2", "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365" },
                      "parameters": { "emailMessage/To": "me@contoso.com" },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                }
              }
            }
          }
        },
        "Compose_connection_ids": {
          "runAfter": { "Condition": ["Succeeded"] },
          "type": "Compose",
          "inputs": {
            "one": "@parameters('$connections')['shared_office365_1']['connectionId']",
            "ten": "@parameters('$connections')['shared_office365_10']['connectionId']"
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
