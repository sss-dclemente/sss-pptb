{
  "name": "@simplesmoothsafe/pptb-envvar-matrix",
  "version": "0.1.2",
  "displayName": "SSS EnvVar & ConnRef Matrix",
  "description": "Environment variables and connection references as a matrix across environments: missing values, differences, copy values between environments, deploymentSettings.json export.",
  "main": "index.html",
  "icon": "icon.svg",
  "license": "MIT",
  "keywords": ["powerplatform", "dataverse", "toolbox", "pptb", "environment-variables", "connection-references", "alm"],
  "author": "Simple Smooth Safe",
  "contributors": [
    { "name": "Duarte Clemente", "url": "https://simplesmoothsafe.com" }
  ],
  "homepage": "https://simplesmoothsafe.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sss-dclemente/sss-pptb.git",
    "directory": "tools/envvar-matrix"
  },
  "configurations": {
    "repository": "https://github.com/sss-dclemente/sss-pptb",
    "website": "https://simplesmoothsafe.com",
    "readmeUrl": "https://raw.githubusercontent.com/sss-dclemente/sss-pptb/main/tools/envvar-matrix/README.md"
  },
  "features": {
    "multiConnection": "optional",
    "connectionRequirement": "required",
    "minAPI": "1.2.0"
  },
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs && node scripts/emit-root-html.mjs",
    "dev-watch": "vite build --mode development --watch",
    "typecheck": "tsc --noEmit",
    "validate": "node node_modules/@pptb/validate/dist/cli.js",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@pptb/types": "^1.2.5",
    "@pptb/validate": "^1.0.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "files": ["dist", "index.html"]
}
